<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/item_backgroung"
    android:padding="12dp"
    android:layout_margin="8dp">

    <ImageButton
        android:id="@+id/imgPizza"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:scaleType="centerCrop"
        android:background="?attr/selectableItemBackground"
        android:contentDescription="Изображение пиццы" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingLeft="16dp">

        <TextView
            android:id="@+id/tvPizzaName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Название пиццы"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvPizzaPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Цена: 0 руб."
            android:textSize="14sp"
            android:textColor="#666" />
        <!-- Кнопка "+" для добавления в корзину -->
    </LinearLayout>

    <TextView
        android:id="@+id/tvCount"
        android:layout_width="27dp"
        android:layout_height="41dp"
        android:layout_marginTop="4dp"
        android:text="0"
        android:textColor="#666"
        android:textSize="14sp" />


    <!-- Кнопка "+" для добавления в корзину -->
</LinearLayout>