<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgPizzaDetail"
            android:layout_width="match_parent"
            android:layout_height="250dp"
            android:scaleType="centerCrop"
            android:contentDescription="Изображение пиццы" />

        <TextView
            android:id="@+id/tvPizzaNameDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Название пиццы"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp" />

        <TextView
            android:id="@+id/tvPizzaPriceDetail"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Цена: 0 руб."
            android:textSize="18sp"
            android:textColor="#E91E63"
            android:layout_marginTop="8dp" />

        <TextView
            android:id="@+id/tvPizzaIngredients"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Ингредиенты: ..."
            android:textSize="14sp"
            android:layout_marginTop="16dp" />

        <Button
            android:id="@+id/btnAddToCartDetail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Добавить в корзину"
            android:layout_marginTop="24dp"
            android:backgroundTint="#E91E63" />
    </LinearLayout>
</ScrollView>