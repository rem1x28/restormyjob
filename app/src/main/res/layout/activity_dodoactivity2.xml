<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Заголовок -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="DODO Pizza"
            android:textSize="24sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="16dp" />

        <!-- Картинка (заглушка — замените на реальную) -->

        <!-- Описание -->
        <ImageView
            android:id="@+id/restaurantImage"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginBottom="16dp"
            android:background="#CCCCCC"
            android:contentDescription="Ресторан DODO Pizza"
            android:scaleType="centerCrop"
            android:src="@drawable/dodooiskapopa" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:lineSpacingMultiplier="1.2"
            android:text="Сеть пиццерий с быстрой доставкой и свежими ингредиентами. Мы готовим пиццу за 15 минут!"
            android:textSize="16sp" />

        <!-- Раздел отзывов -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Отзывы"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <!-- Отзыв 1 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="«Отличная пицца, быстрая доставка! Всегда заказываю здесь.» — Анна, 5 звезд"
            android:textSize="14sp"
            android:layout_marginBottom="8dp" />

        <!-- Отзыв 2 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="«Вкусная пицца по доступной цене. Рекомендую!» — Иван, 5 звезд"
            android:textSize="14sp"
            android:layout_marginBottom="16dp" />

        <!-- Контейнер для кнопок (внизу экрана) -->
        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="170dp"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:orientation="vertical">

            <!-- Кнопка «Сделать заказ» (слева) -->
            <!-- Отступ между кнопками -->

            <!-- Кнопка «Забронировать столик» (справа) -->

            <Button
                android:layout_margin="10dp"
                android:id="@+id/btnOrder"
                android:layout_width="match_parent"
                android:layout_height="62dp"
                android:layout_gravity="bottom|center"
                android:layout_weight="1"
                android:onClick="goToOrderPage"
                android:background="@drawable/button_rounded1"
                android:shadowColor="#FFFFFF"
                android:text="Сделать заказ"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <Button
                android:layout_margin="10dp"
                android:id="@+id/btnReserve"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_gravity="bottom|center"
                android:layout_weight="1"
                android:background="@drawable/button_rounded1"
                android:shadowColor="#FFFFFF"
                android:text="Забронировать столик"
                android:textColor="@color/black"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
